# Build directories
/build/
/build-*/
build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
*.bbl
*.blg
report/generated/

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store

# Project outputs that are regenerated, not committed
*.nbin
# Atomic write temporaries from run_benchmarks.py.
/experiments/results/*.json.tmp
/experiments/results/*.tmp
# Generated models stay ignored: they are rebuilt deterministically from a seed
# by model_generator, so committing them would be committing a cache. The seed
# and the generator version travel in each result's manifest instead, which is
# what makes the regeneration reproducible.
/experiments/models/*.onnx

# Note: /experiments/results/*.json is deliberately NOT ignored. Every number in
# the README and both reports traces back to those files, so a fresh clone has
# to contain them. See docs/ASSESSMENT.md section 4.2.
