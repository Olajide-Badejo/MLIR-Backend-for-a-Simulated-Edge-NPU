# SPDX-FileCopyrightText: 2026 Olajide Badejo <olajideayomidebadejo@gmail.com>
#
# SPDX-License-Identifier: MIT
#
# The prebuilt LLVM and MLIR image that every build-and-test job pulls.
#
# Section 0.4 of the build specification puts "rebuilding LLVM" out of scope
# and then names exactly one exemption, which is this file: it builds the same
# tag, llvmorg-22.1.8, on GitHub's hardware rather than on mine, so that CI
# spends seconds pulling instead of an hour compiling. It never runs inside
# WSL2.
#
# Section 19 says the binding constraint on a hosted runner is disk, not time:
# roughly 14 GB free against an LLVM release build with assertions that lands
# somewhere between 20 and 40 GB. Three mitigations are mandatory, and all
# three are here or in the workflow that drives this file:
#
#   1. The workflow reclaims the runner's preinstalled toolchains before the
#      build starts. That is in .github/workflows/llvm-image.yml, because it
#      is a property of the runner rather than of the image.
#   2. `ninja install` writes a slim prefix at /opt/llvm and only that prefix
#      is copied into the final stage, so the multi tens of gigabytes build
#      tree stays in the discarded builder layer and never ships.
#   3. LLVM_TARGETS_TO_BUILD is Native and the only enabled project is MLIR.
#
# Base pin. Section 3's environment hardening wants the base pinned by sha256
# digest rather than by tag at P0, because the image is published at P0 and
# repinning a published image later means republishing it. The digest below is
# the linux/amd64 manifest of ubuntu:24.04, resolved on 2026-08-19 with
# docker 29.6.1 in WSL2 by two commands that agreed:
#
#   docker manifest inspect ubuntu:24.04
#   docker buildx imagetools inspect ubuntu:24.04
#
# Both report the linux/amd64 child manifest as
# sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316,
# under the multi platform index sha256:d78ab76437b1afc5f01e223d6bf0172763f4
# 04bb166441328845adbef44518cb. The platform specific digest is the one pinned
# here rather than the index digest, because the runner and this image are
# both linux/amd64 and pinning the child manifest removes the index as a
# degree of freedom. The image annotates itself as ubuntu 24.04 built from
# revision 461fbe29535e51d03451ae146a90f730671d950d on 2026-08-10.

# ---------------------------------------------------------------------------
# Stage 1: build LLVM and MLIR, install into a slim prefix, discard the rest.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316 AS builder

ARG LLVM_TAG=llvmorg-22.1.8
ARG LLVM_PREFIX=/opt/llvm
# A hosted runner is 4 vCPU and 16 GB. Compiling with -j4 uses the cores;
# linking is the memory hungry half, so link jobs are held at 2 to keep two
# concurrent lld invocations inside 16 GB rather than inviting the OOM killer
# into a 40 minute build.
ARG BUILD_JOBS=4
ARG LINK_JOBS=2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --no-install-recommends --yes \
      build-essential \
      ca-certificates \
      ccache \
      clang \
      cmake \
      git \
      lld \
      ninja-build \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

# lit is what `ninja check-npu` drives the lit suite with. It comes from pip
# rather than from the LLVM build tree because only the slim prefix survives
# into the final stage, and --break-system-packages is the honest way to say
# "this container is the environment" to a PEP 668 marked Debian python.
#
# nanobind, numpy and PyYAML are the build dependencies of
# MLIR_ENABLE_BINDINGS_PYTHON, which is ON from this revision. MLIR generates
# the binding sources at configure time from tablegen and compiles them against
# nanobind's headers, so nanobind is a build requirement of this stage; numpy is
# both a build and a runtime requirement, because the generated module imports it
# to expose dense elements attributes as arrays.
#
# The three versions are exactly the ones in requirements-lock.txt, deliberately
# and not coincidentally. The bindings this image ships are the ones the P3
# importer imports, so a numpy in the image that differs from the numpy in the
# lock file is two numpys in one pipeline and the kind of disagreement that shows
# up as a dtype mismatch nobody can reproduce locally. If the lock file moves,
# these move with it in the same commit.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      lit==18.1.8 \
      nanobind==2.13.0 \
      numpy==2.5.1 \
      PyYAML==6.0.3

# A shallow clone of one tag. --depth 1 against a tag is the whole reason this
# fits: the full llvm-project history is several gigabytes of objects that no
# part of the build reads.
WORKDIR /src
RUN git clone --depth 1 --branch "${LLVM_TAG}" \
      https://github.com/llvm/llvm-project.git llvm-project \
 && git -C llvm-project rev-parse HEAD > /tmp/llvm-project-sha.txt \
 && cat /tmp/llvm-project-sha.txt

# Release plus assertions is the configuration this project develops against,
# and assertions are the point: an MLIR verifier failure that fires as an
# assertion in CI is a bug found, where the same build without assertions is a
# bug shipped.
#
# LLVM_INSTALL_UTILS=ON is critical rather than cosmetic. Without it the
# install prefix ships mlir-opt and the CMake packages but not FileCheck, not,
# or count, and `ninja check-npu` cannot run a single lit test: lit resolves
# FileCheck out of the LLVM tools directory and reports every test unresolved.
# This flag is the difference between an image that builds this project and an
# image that builds it and can also test it.
#
# MLIR_ENABLE_BINDINGS_PYTHON is ON from this revision, where it was OFF at P0.
# The change is made here at P2 rather than at P3, and one republish covers both
# reasons, which is the whole point of doing it now:
#
#   - **P2 needs googletest in the final image** so the `NPUInterfaceTests` step
#     the activation table switches on at P2 has a binary to run. Against an
#     installed LLVM prefix there is no `llvm_gtest` target and no bundled gtest
#     headers, so before this the unit tests were simply not built in CI.
#   - **P3 needs the bindings**, because the ONNX importer of Section 11 is
#     written against the MLIR Python bindings and the pytest job cannot collect
#     a single test without them.
#
# Publishing this image is an hour of runner time, so doing the two together
# costs one republish where doing them separately costs two. The P0 note this
# replaces said the bindings change was a P3 deliverable; it lands a phase early
# and P3 inherits it done.
#
# The build cost is real and is worth stating rather than eliding: the bindings
# add the nanobind compilation of every dialect's Python module to a build that
# was already the long pole. The slim prefix discipline is unchanged, though.
# `ninja install` still writes only /opt/llvm and only /opt/llvm is copied into
# the final stage; the bindings land inside that prefix rather than beside it.
#
# **Where the bindings land, which is the path P3 needs:**
#
#     /opt/llvm/python_packages/mlir_core
#
# That is the directory to put on PYTHONPATH. The `mlir` package itself is one
# level below it, at /opt/llvm/python_packages/mlir_core/mlir, because MLIR's
# MLIR_BINDINGS_PYTHON_INSTALL_PREFIX defaults to `python_packages/mlir_core/mlir`
# and *ends at the package directory* rather than at the directory to import
# from. Getting that one level wrong is the obvious mistake here and it produces
# an ImportError naming `mlir` in an image that does contain it, so the two paths
# are both written out. The default is used rather than overridden: the ENV below
# and the smoke test at the end of the final stage both pin it, so an LLVM that
# changed the default would fail this build rather than ship a broken image.
RUN cmake -G Ninja -S llvm-project/llvm -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DLLVM_ENABLE_ASSERTIONS=ON \
      -DLLVM_ENABLE_PROJECTS=mlir \
      -DLLVM_TARGETS_TO_BUILD=Native \
      -DLLVM_INSTALL_UTILS=ON \
      -DMLIR_ENABLE_BINDINGS_PYTHON=ON \
      -DPython3_EXECUTABLE=/usr/bin/python3 \
      -DLLVM_ENABLE_RTTI=ON \
      -DLLVM_INCLUDE_TESTS=OFF \
      -DLLVM_INCLUDE_BENCHMARKS=OFF \
      -DLLVM_INCLUDE_EXAMPLES=OFF \
      -DLLVM_ENABLE_ZSTD=OFF \
      -DLLVM_USE_LINKER=lld \
      -DLLVM_PARALLEL_LINK_JOBS="${LINK_JOBS}" \
      -DCMAKE_C_COMPILER=clang \
      -DCMAKE_CXX_COMPILER=clang++ \
      -DCMAKE_INSTALL_PREFIX="${LLVM_PREFIX}"

# Build and install in one layer, then delete the build tree in that same
# layer. Splitting these into separate RUN instructions would freeze the build
# tree into an image layer, and a deletion in a later layer does not shrink an
# earlier one: the tens of gigabytes would still have to be written to disk on
# the runner as part of the builder image. Only the /opt/llvm prefix survives.
RUN cmake --build build -- -j"${BUILD_JOBS}" \
 && cmake --install build \
 && cp /tmp/llvm-project-sha.txt "${LLVM_PREFIX}/llvm-project-sha.txt" \
 && cp build/CMakeCache.txt "${LLVM_PREFIX}/llvm-CMakeCache.txt" \
 && (clang --version > "${LLVM_PREFIX}/build-compiler-version.txt") \
 && rm -rf /src/build /src/llvm-project \
 && du -sh "${LLVM_PREFIX}"

# ---------------------------------------------------------------------------
# Stage 2: the shipped image. Runtime dependencies plus the slim prefix.
# ---------------------------------------------------------------------------
FROM ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316

ARG LLVM_TAG=llvmorg-22.1.8
ARG LLVM_PREFIX=/opt/llvm

LABEL org.opencontainers.image.title="npu-mlir-llvm" \
      org.opencontainers.image.description="LLVM and MLIR ${LLVM_TAG}, Release with assertions, Native target, installed at ${LLVM_PREFIX}" \
      org.opencontainers.image.source="https://github.com/Olajide-Badejo/MLIR-Backend-for-a-Simulated-Edge-NPU" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive

# What is left is only what building and testing this repository against the
# prefix needs: a compiler, lld, cmake, ninja, python3 for lit and for the
# repository's own scripts, git because CI checks out into this container, and
# ccache because the workflow caches its directory across runs.
#
# libgtest-dev is the P2 addition and it is what makes the unit test binaries
# buildable in CI at all. An installed LLVM prefix exports neither the
# `llvm_gtest` target nor the bundled gtest headers, both of which live only in
# an LLVM *build tree*, so the top level CMakeLists falls back to
# `find_package(GTest)` and this package is what that finds. On this base it
# ships prebuilt static libraries and a CMake package config at
# /usr/lib/x86_64-linux-gnu/cmake/GTest, so no source build is needed; older
# Debian derivatives shipped sources only, which is why the smoke test at the
# end of this stage checks for the config file rather than assuming it.
# libclang-rt-18-dev carries the sanitizer runtime archives
# (libclang_rt.asan*.a and friends) that -fsanitize=address,undefined links
# against. Ubuntu packages them separately from clang itself, so an image with
# clang but without this package can compile with the sanitizers and then fail
# at the first link, which is exactly how the sanitizers job died on its first
# CI run (D-0025). The version is pinned to the clang this base ships.
#
# libomp-18-dev is the P9b addition and it closes the OpenMP split P7 found and
# P8 explained. Three jobs build this project in this image and two of them were
# getting a weaker test than the third. build-and-test and sanitizers configure
# with -DCMAKE_C_COMPILER=clang, and clang's OpenMP wants libomp and omp.h,
# which no package here supplied; the coverage job passes no compiler, gets gcc,
# and finds libgomp because g++ brings it. So `find_package(OpenMP)` printed
# "OpenMP: not found" in two jobs and "found" in the third, out of one image.
#
# What that cost is specific rather than general. Section 10.3's determinism
# claim is that one thread and the maximum produce bitwise equal buffers, and
# `unittests/Simulator/DeterminismTest.cpp` says so in its own output: without
# OpenMP both of its runs are single threaded and it asserts that a number
# equals itself. The claim was being made at full strength only in the coverage
# job and on developer machines.
#
# The name is pinned the same way libclang-rt-18-dev is and for the same
# reason: `libomp-dev` is a metapackage that follows whatever clang the archive
# currently defaults to, and an image whose OpenMP runtime and whose clang can
# drift apart is a link error waiting for a mirror to move. This base ships
# clang 18, so this is the 18 package.
RUN apt-get update && apt-get install --no-install-recommends --yes \
      build-essential \
      ca-certificates \
      ccache \
      clang \
      cmake \
      git \
      libclang-rt-18-dev \
      libgtest-dev \
      libomp-18-dev \
      lld \
      ninja-build \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

# numpy is a runtime dependency of the bindings this image now ships, so it is
# installed here as well as in the builder stage: the builder's site-packages
# does not survive into this stage, only /opt/llvm does.
#
# gcovr is what scripts/coverage.sh collects with, and the coverage job of the
# activation table switches on at P2. Without it in the image that job would
# fail at the tool check rather than measure anything.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      lit==18.1.8 \
      numpy==2.5.1 \
      gcovr==8.6

COPY --from=builder /opt/llvm /opt/llvm

# MLIR_DIR and LLVM_DIR are exported so a configure inside this image can be
# written without repeating the paths, but ci.yml passes them explicitly all
# the same: a workflow that depends on an environment variable set in an image
# breaks silently the day the image changes, and the explicit -D flags are the
# documentation of what the image is expected to contain.
#
# PYTHONPATH is the P2 addition, and it is the directory to import the bindings
# *from*, not the package itself: the `mlir` package sits at
# /opt/llvm/python_packages/mlir_core/mlir and Python has to be pointed at its
# parent. P3's importer relies on this being set in the image.
ENV PATH="/opt/llvm/bin:${PATH}" \
    MLIR_DIR="/opt/llvm/lib/cmake/mlir" \
    LLVM_DIR="/opt/llvm/lib/cmake/llvm" \
    PYTHONPATH="/opt/llvm/python_packages/mlir_core"

# A build argument cannot be read at container run time, so the tag is frozen
# into the environment here. The result manifest of Section 3 reads it.
ENV NPU_LLVM_TAG="${LLVM_TAG}"

# Fail the build rather than publish an image that cannot test anything. Each
# of these is a thing a CI job will ask for within minutes of the first pull,
# and finding out here costs one build where finding out there costs a red run
# and a bisect through a Dockerfile.
#
# **The OpenMP check compiles and runs a program rather than testing for a
# file**, which is the same argument the bindings check makes two lines below by
# importing `mlir.ir` and constructing a `Context`. A present omp.h with no
# runtime to link against is precisely the failure D-0025 was, one library
# along, and `test -f` cannot tell the two apart. A build that reached here
# without OpenMP would publish an image in which Section 10.3's determinism
# assertion silently compares a single threaded run against itself.
RUN printf '#include <omp.h>\nint main(void) { return omp_get_max_threads() > 0 ? 0 : 1; }\n' \
      > /tmp/openmp-smoke.c \
 && clang -fopenmp /tmp/openmp-smoke.c -o /tmp/openmp-smoke \
 && /tmp/openmp-smoke \
 && rm -f /tmp/openmp-smoke.c /tmp/openmp-smoke \
 && echo "OpenMP: clang -fopenmp compiles, links and runs in this image"

RUN mlir-opt --version \
 && test -f /opt/llvm/lib/cmake/mlir/MLIRConfig.cmake \
 && test -f /opt/llvm/lib/cmake/llvm/LLVMConfig.cmake \
 && command -v FileCheck \
 && command -v not \
 && command -v count \
 && command -v lit \
 && command -v ninja \
 && command -v ccache \
 && command -v gcovr \
 && command -v gcov \
 && test -f /usr/lib/x86_64-linux-gnu/cmake/GTest/GTestConfig.cmake \
 && test -f /usr/lib/x86_64-linux-gnu/libgtest.a \
 && test -f /usr/lib/x86_64-linux-gnu/libgtest_main.a \
 && test -d /opt/llvm/python_packages/mlir_core/mlir \
 && python3 -c "import mlir.ir; ctx = mlir.ir.Context(); print('mlir bindings import ok')" \
 && python3 -c "import numpy; print('numpy', numpy.__version__)"

WORKDIR /work
